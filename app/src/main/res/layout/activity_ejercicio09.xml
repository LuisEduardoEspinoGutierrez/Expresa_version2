<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ejercicios.Ejercicio09">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#38A9F5"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivRegresarEje09"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regresar"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sopa de letras"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:paddingBottom="10dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#38A9F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Instrucciones"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <Button
                            android:id="@+id/btnAudioInstruccionesEje09"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escuchar"
                            android:textAllCaps="false"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconSize="20dp"
                            app:iconTint="#FFFFFF"
                            app:iconPadding="10dp"
                            app:iconGravity="textStart"
                            android:backgroundTint="#FFA726"
                            app:cornerRadius="20dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Encuentra las palabras deslizando tu dedo sobre ellas en la cuadrícula."
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="#FFFFFF">

                <com.example.tt2.ejercicios.SopaDeLetrasViewDalia
                    android:id="@+id/sopaDeLetrasViewEje09"
                    android:layout_width="match_parent"
                    android:layout_height="400dp" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Palabras a encontrar:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="#FFFFFF">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPalabrasEje09"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="4dp"
                    android:gravity="center"
                    android:padding="15dp"
                    android:animateLayoutChanges="true">

                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_dragón" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DRAGÓN" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_madre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MADRE" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_cuadrado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CUADRADO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_vidrio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VIDRIO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_cocodrilo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COCODRILO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_cuadro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CUADRO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_ladrillo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LADRILLO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_almendra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALMENDRA" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_taladro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TALADRO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_piedra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIEDRA" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_ladrar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LADRAR" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_escuadra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESCUADRA" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_dromedario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DROMEDARIO" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_ladrón" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LADRÓN" app:chipBackgroundColor="#EBF5FB"/>
                    <com.google.android.material.chip.Chip style="@style/Widget.MaterialComponents.Chip.Action" android:id="@+id/chip_salamandra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SALAMANDRA" app:chipBackgroundColor="#EBF5FB"/>

                </com.google.android.material.chip.ChipGroup>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnFinalizarEje09"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar"
            android:backgroundTint="#38A9F5"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>