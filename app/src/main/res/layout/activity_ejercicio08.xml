                        android:src="@drawable/eje08_img29" />

                    <ImageView
                        android:id="@+id/eje08_img30"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_columnWeight="1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/eje08_img30" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="#FFFFFF">

                <com.example.tt2.ejercicios.SopaDeLetrasViewDalia
                    android:id="@+id/sopaDeLetrasViewEje08"
                    android:layout_width="match_parent"
                    android:layout_height="400dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnFinalizarEje08"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar"
            android:backgroundTint="#38A9F5"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</LinearLayout>