<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".rewards.Reward1">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/btnRegresarBarra"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#38A9F5"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ivRegresarRew1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regresar"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fondos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Escenarios"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Escenario 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivEsc1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_esc1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Escenario 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivEsc2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_esc2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recompensa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReward"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivReward1"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/reward1_din0"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Color -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Color"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Color 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivC1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_c1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Color 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivC2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_c2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Color 3 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivC3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_c3_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ropa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ropa"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Ropa 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRp1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_r1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Ropa 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRp2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward1_r2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>