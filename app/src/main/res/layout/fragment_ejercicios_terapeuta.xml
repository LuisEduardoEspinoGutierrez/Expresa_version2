<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TerapeutaEjerciciosFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicios Asignados a Niños"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp" />

    <!-- Panel superior para desasignar ejercicios de pacientes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAsignacionesPacientes"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#F8F9FA"
        android:layout_marginHorizontal="16dp"
        android:elevation="2dp"
        tools:listitem="@layout/item_asignacion_paciente" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis Ejercicios Disponibles"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp" />

    <!-- RecyclerView para el catálogo de ejercicios que el terapeuta tiene permitidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEjerciciosParaAsignar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_catalogo_ejercicio" />

</LinearLayout>