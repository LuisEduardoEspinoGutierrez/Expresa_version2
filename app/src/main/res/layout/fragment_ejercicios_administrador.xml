<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AdministradorEjerciciosFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicios Asignados (Panel de Control)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp" />

    <!-- Panel superior de desasignación -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAsignacionesAdmin"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#F8F9FA"
        android:layout_marginHorizontal="16dp"
        android:elevation="2dp"
        tools:listitem="@layout/item_asignacion_admin" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catálogo de Ejercicios para Asignar"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCargarFirestore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sincronizar"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnIrEjercicio16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver Ejercicio 16"
            android:backgroundTint="#38A9F5"
            android:textColor="@android:color/white"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- RecyclerView para el catálogo con las cajitas solicitadas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalogoEjercicios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_catalogo_ejercicio" />

</LinearLayout>