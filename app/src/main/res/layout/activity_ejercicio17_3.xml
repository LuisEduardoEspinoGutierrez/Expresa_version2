<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".ejercicios.Ejercicio17_3">

    <!-- Barra de regreso superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#38A9F5"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivRegresarEje17_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regresar"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewEje17_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <!-- Caja de Instrucciones -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#38A9F5"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Instrucciones"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <Button
                            android:id="@+id/btnAudioInstruccionesEje17_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Escuchar"
                            android:textAllCaps="false"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconSize="20dp"
                            app:iconTint="#FFFFFF"
                            app:iconPadding="10dp"
                            app:iconGravity="textStart"
                            android:backgroundTint="#FFA726"
                            app:cornerRadius="20dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Escucha y repite el sonido 'irri'.\n• Observa el movimiento de la lengua.\n• Practica 'irri' varias veces.\n• Luego di las palabras mostradas abajo."
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nueva Vista de Cámara del Usuario (220x220) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUserCamera17_3"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="15dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewViewCameraUser17_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Vista para reproducir el video grabado -->
                    <TextureView
                        android:id="@+id/textureViewUserPlayback17_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRecordingStatusUser17_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="#80000000"
                        android:padding="8dp"
                        android:text="Grabando..."
                        android:textColor="#FF0000"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contenedor del Video de Guía -->
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="15dp">

                <!-- Texto Dinámico y Botón de Cambio (Fijo a la derecha) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_gravity="top">

                    <ImageView
                        android:id="@+id/btnCambiarVideo17_3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_popup_camera"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tvDinamico17_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/btnCambiarVideo17_3"
                        android:layout_alignParentStart="true"
                        android:gravity="center"
                        android:text="irri, irri"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#38A9F5"
                        android:visibility="gone"/>
                </RelativeLayout>

                <!-- Contenedor del Video de Guía -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoContainer17_3"
                    android:layout_width="260dp"
                    android:layout_height="320dp"
                    android:layout_marginTop="50dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <FrameLayout
                        android:id="@+id/videoContainer17_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF">

                        <TextureView
                            android:id="@+id/textureViewEjercicio17_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <ImageView
                            android:id="@+id/ivVideoPreviewEje17_3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:layout_gravity="center"
                            android:visibility="visible" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Controles del Video de Guía -->
            <LinearLayout
                android:id="@+id/layoutControlesGuia17_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">

                <Button
                    android:id="@+id/btnPlayVideoEje17_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reproducir"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    app:icon="@android:drawable/ic_media_play"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnPauseVideoEje17_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pausa"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    app:icon="@android:drawable/ic_media_pause"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botón de acción inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnGrabarVideoEje17_3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ya lo vi, ahora lo intento"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#38A9F5"
            android:textColor="#FFFFFF"
            app:cornerRadius="15dp"/>

        <Button
            android:id="@+id/btnComenzarGrabacion17_3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Empieza grabación"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:cornerRadius="15dp"/>

        <Button
            android:id="@+id/btnDetenerGrabacion17_3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Finalizar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:cornerRadius="15dp"/>

        <!-- Layout con Subir y Grabar de nuevo -->
        <LinearLayout
            android:id="@+id/layoutPostGrabacion17_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnGrabarDeNuevo17_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Grabar de nuevo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#FF5252"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                app:cornerRadius="15dp"/>

            <Button
                android:id="@+id/btnSubirVideo17_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Subir"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#FFA726"
                android:textColor="#FFFFFF"
                app:cornerRadius="15dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
